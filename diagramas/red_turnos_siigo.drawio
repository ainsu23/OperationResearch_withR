arent="1" source="Ltrab" target="Mlib"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="e82" value="" style="endArrow=block;endFill=1;html=1;rounded=0;strokeColor=#374151;fontSize=11;labelBackgroundColor=#ffffff;dashed=1;" edge="1" parent="1" source="Ltrab" target="Mman"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="e83" value="" style="endArrow=block;endFill=1;html=1;rounded=0;strokeColor=#374151;fontSize=11;labelBackgroundColor=#ffffff;" edge="1" parent="1" source="Llib" target="Mtrab"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="e84" value="" style="endArrow=block;endFill=1;html=1;rounded=0;strokeColor=#374151;fontSize=11;labelBackgroundColor=#ffffff;" edge="1" parent="1" source="Llib" target="Mlib"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="e85" value="" style="endArrow=block;endFill=1;html=1;rounded=0;strokeColor=#374151;fontSize=11;labelBackgroundColor=#ffffff;" edge="1" parent="1" source="Llib" target="Mman"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="e86" value="" style="endArrow=block;endFill=1;html=1;rounded=0;strokeColor=#374151;fontSize=11;labelBackgroundColor=#ffffff;dashed=1;" edge="1" parent="1" source="Ltarde" target="Mtrab"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="e87" value="" style="endArrow=block;endFill=1;html=1;rounded=0;strokeColor=#374151;fontSize=11;labelBackgroundColor=#ffffff;" edge="1" parent="1" source="Ltarde" target="Mlib"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="e88" value="" style="endArrow=block;endFill=1;html=1;rounded=0;strokeColor=#374151;fontSize=11;labelBackgroundColor=#ffffff;dashed=1;" edge="1" parent="1" source="Ltarde" target="Mman"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="e89" value="" style="endArrow=block;endFill=1;html=1;rounded=0;strokeColor=#374151;fontSize=11;labelBackgroundColor=#ffffff;" edge="1" parent="1" source="c_inicio" target="c_lun"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="e90" value="" style="endArrow=block;endFill=1;html=1;rounded=0;strokeColor=#374151;fontSize=11;labelBackgroundColor=#ffffff;" edge="1" parent="1" source="c_lun" target="c_mar"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="e91" value="4" style="endArrow=block;endFill=1;html=1;rounded=0;strokeColor=#374151;fontSize=11;labelBackgroundColor=#ffffff;" edge="1" parent="1" source="c_mar" target="c_mie"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="e92" value="4" style="endArrow=block;endFill=1;html=1;rounded=0;strokeColor=#374151;fontSize=11;labelBackgroundColor=#ffffff;" edge="1" parent="1" source="c_mie" target="c_jue"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="e93" value="vie, sáb" style="endArrow=block;endFill=1;html=1;rounded=0;strokeColor=#374151;fontSize=11;labelBackgroundColor=#ffffff;" edge="1" parent="1" source="c_jue" target="c_dom"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="e94" value="" style="endArrow=block;endFill=1;html=1;rounded=0;strokeColor=#374151;fontSize=11;labelBackgroundColor=#ffffff;" edge="1" parent="1" source="c_dom" target="c_fin"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="t0" value="A. Un día de Andrés (lun 26 oct), bloques de 30 min" style="text;html=1;align=left;verticalAlign=middle;fontSize=18;fontStyle=1;" vertex="1" parent="1"><mxGeometry x="20" y="18" width="1760" height="24" as="geometry"/></mxCell><mxCell id="t1" value="«inicio» existe una sola vez por persona. Entrada a las 07:00, 07:30, 08:00 u 08:30. Cada fila «Trabaja» es una etapa del día: solo se baja de etapa por un descanso o por el almuerzo (confirmado)." style="text;html=1;align=left;verticalAlign=middle;fontSize=13;" vertex="1" parent="1"><mxGeometry x="20" y="42" width="1760" height="24" as="geometry"/></mxCell><mxCell id="t2" value="Trabaja · antes de Descanso1" style="text;html=1;align=center;verticalAlign=middle;fontSize=12;fontStyle=1;" vertex="1" parent="1"><mxGeometry x="365.0" y="160" width="320" height="24" as="geometry"/></mxCell><mxCell id="t3" value="Descanso1 · 15 min: 2 opciones por bloque" style="text;html=1;align=right;verticalAlign=middle;fontSize=12;fontStyle=1;" vertex="1" parent="1"><mxGeometry x="60" y="243" width="320" height="24" as="geometry"/></mxCell><mxCell id="t4" value="Trabaja · entre Descanso1 y almuerzo" style="text;html=1;align=right;verticalAlign=middle;fontSize=12;fontStyle=1;" vertex="1" parent="1"><mxGeometry x="138" y="298" width="320" height="24" as="geometry"/></mxCell><mxCell id="t5" value="Almuerzo · 1ª media hora (4 opciones)" style="text;html=1;align=right;verticalAlign=middle;fontSize=12;fontStyle=1;" vertex="1" parent="1"><mxGeometry x="558" y="358" width="320" height="24" as="geometry"/></mxCell><mxCell id="t6" value="Almuerzo · 2ª media hora" style="text;html=1;align=right;verticalAlign=middle;fontSize=12;fontStyle=1;" vertex="1" parent="1"><mxGeometry x="628" y="408" width="320" height="24" as="geometry"/></mxCell><mxCell id="t7" value="Trabaja · entre almuerzo y Descanso2" style="text;html=1;align=right;verticalAlign=middle;fontSize=12;fontStyle=1;" vertex="1" parent="1"><mxGeometry x="698" y="468" width="320" height="24" as="geometry"/></mxCell><mxCell id="t8" value="Descanso2 · 15 min: 2 opciones por bloque" style="text;html=1;align=right;verticalAlign=middle;fontSize=12;fontStyle=1;" vertex="1" parent="1"><mxGeometry x="830" y="523" width="320" height="24" as="geometry"/></mxCell><mxCell id="t9" value="Trabaja · después de Descanso2" style="text;html=1;align=right;verticalAlign=middle;fontSize=12;fontStyle=1;" vertex="1" parent="1"><mxGeometry x="908" y="578" width="320" height="24" as="geometry"/></mxCell><mxCell id="t10" value="07:00" style="text;html=1;align=center;verticalAlign=middle;fontSize=11;" vertex="1" parent="1"><mxGeometry x="50.0" y="80" width="320" height="24" as="geometry"/></mxCell><mxCell id="t11" value="07:30" style="text;html=1;align=center;verticalAlign=middle;fontSize=11;" vertex="1" parent="1"><mxGeometry x="120.0" y="80" width="320" height="24" as="geometry"/></mxCell><mxCell id="t12" value="08:00" style="text;html=1;align=center;verticalAlign=middle;fontSize=11;" vertex="1" parent="1"><mxGeometry x="190.0" y="80" width="320" height="24" as="geometry"/></mxCell><mxCell id="t13" value="08:30" style="text;html=1;align=center;verticalAlign=middle;fontSize=11;" vertex="1" parent="1"><mxGeometry x="260.0" y="80" width="320" height="24" as="geometry"/></mxCell><mxCell id="t14" value="09:00" style="text;html=1;align=center;verticalAlign=middle;fontSize=11;" vertex="1" parent="1"><mxGeometry x="330.0" y="80" width="320" height="24" as="geometry"/></mxCell><mxCell id="t15" value="09:30" style="text;html=1;align=center;verticalAlign=middle;fontSize=11;" vertex="1" parent="1"><mxGeometry x="400.0" y="80" width="320" height="24" as="geometry"/></mxCell><mxCell id="t16" value="10:00" style="text;html=1;align=center;verticalAlign=middle;fontSize=11;" vertex="1" parent="1"><mxGeometry x="470.0" y="80" width="320" height="24" as="geometry"/></mxCell><mxCell id="t17" value="10:30" style="text;html=1;align=center;verticalAlign=middle;fontSize=11;" vertex="1" parent="1"><mxGeometry x="540.0" y="80" width="320" height="24" as="geometry"/></mxCell><mxCell id="t18" value="11:00" style="text;html=1;align=center;verticalAlign=middle;fontSize=11;" vertex="1" parent="1"><mxGeometry x="610.0" y="80" width="320" height="24" as="geometry"/></mxCell><mxCell id="t19" value="11:30" style="text;html=1;align=center;verticalAlign=middle;fontSize=11;" vertex="1" parent="1"><mxGeometry x="680.0" y="80" width="320" height="24" as="geometry"/></mxCell><mxCell id="t20" value="12:00" style="text;html=1;align=center;verticalAlign=middle;fontSize=11;" vertex="1" parent="1"><mxGeometry x="750.0" y="80" width="320" height="24" as="geometry"/></mxCell><mxCell id="t21" value="12:30" style="text;html=1;align=center;verticalAlign=middle;fontSize=11;" vertex="1" parent="1"><mxGeometry x="820.0" y="80" width="320" height="24" as="geometry"/></mxCell><mxCell id="t22" value="13:00" style="text;html=1;align=center;verticalAlign=middle;fontSize=11;" vertex="1" parent="1"><mxGeometry x="890.0" y="80" width="320" height="24" as="geometry"/></mxCell><mxCell id="t23" value="13:30" style="text;html=1;align=center;verticalAlign=middle;fontSize=11;" vertex="1" parent="1"><mxGeometry x="960.0" y="80" width="320" height="24" as="geometry"/></mxCell><mxCell id="t24" value="14:00" style="text;html=1;align=center;verticalAlign=middle;fontSize=11;" vertex="1" parent="1"><mxGeometry x="1030.0" y="80" width="320" height="24" as="geometry"/></mxCell><mxCell id="t25" value="14:30" style="text;html=1;align=center;verticalAlign=middle;fontSize=11;" vertex="1" parent="1"><mxGeometry x="1100.0" y="80" width="320" height="24" as="geometry"/></mxCell><mxCell id="t26" value="15:00" style="text;html=1;align=center;verticalAlign=middle;fontSize=11;" vertex="1" parent="1"><mxGeometry x="1170.0" y="80" width="320" height="24" as="geometry"/></mxCell><mxCell id="t27" value="15:30" style="text;html=1;align=center;verticalAlign=middle;fontSize=11;" vertex="1" parent="1"><mxGeometry x="1240.0" y="80" width="320" height="24" as="geometry"/></mxCell><mxCell id="t28" value="16:00" style="text;html=1;align=center;verticalAlign=middle;fontSize=11;" vertex="1" parent="1"><mxGeometry x="1310.0" y="80" width="320" height="24" as="geometry"/></mxCell><mxCell id="t29" value="16:30" style="text;html=1;align=center;verticalAlign=middle;fontSize=11;" vertex="1" parent="1"><mxGeometry x="1380.0" y="80" width="320" height="24" as="geometry"/></mxCell><mxCell id="t30" value="17:00" style="text;html=1;align=center;verticalAlign=middle;fontSize=11;" vertex="1" parent="1"><mxGeometry x="1450.0" y="80" width="320" height="24" as="geometry"/></mxCell><mxCell id="t31" value="17:30" style="text;html=1;align=center;verticalAlign=middle;fontSize=11;" vertex="1" parent="1"><mxGeometry x="1520.0" y="80" width="320" height="24" as="geometry"/></mxCell><mxCell id="t32" value="Arco Trabaja → Trabaja: costo 0,5. Arco hacia o desde Libre: costo 4. Punteado = por confirmar." style="text;html=1;align=left;verticalAlign=middle;fontSize=12;" vertex="1" parent="1"><mxGeometry x="950" y="688" width="1760" height="24" as="geometry"/></mxCell><mxCell id="t33" value="B. Unión entre dos días: no hay inicio ni Fin por día" style="text;html=1;align=left;verticalAlign=middle;fontSize=18;fontStyle=1;" vertex="1" parent="1"><mxGeometry x="20" y="758" width="1760" height="24" as="geometry"/></mxCell><mxCell id="t34" value="Los nodos donde termina el lunes se conectan directamente con los nodos donde empieza el martes." style="text;html=1;align=left;verticalAlign=middle;fontSize=13;" vertex="1" parent="1"><mxGeometry x="20" y="782" width="1760" height="24" as="geometry"/></mxCell><mxCell id="t35" value="termina lun 26" style="text;html=1;align=center;verticalAlign=middle;fontSize=13;fontStyle=1;" vertex="1" parent="1"><mxGeometry x="200.0" y="816" width="320" height="24" as="geometry"/></mxCell><mxCell id="t36" value="empieza mar 27" style="text;html=1;align=center;verticalAlign=middle;fontSize=13;fontStyle=1;" vertex="1" parent="1"><mxGeometry x="940.0" y="816" width="320" height="24" as="geometry"/></mxCell><mxCell id="t37" value="Arcos que tocan Libre: costo 4 (sólidos)." style="text;html=1;align=left;verticalAlign=middle;fontSize=13;" vertex="1" parent="1"><mxGeometry x="1260" y="873" width="1760" height="24" as="geometry"/></mxCell><mxCell id="t38" value="Arcos sin Libre: costo por confirmar (punteados)." style="text;html=1;align=left;verticalAlign=middle;fontSize=13;" vertex="1" parent="1"><mxGeometry x="1260" y="898" width="1760" height="24" as="geometry"/></mxCell><mxCell id="t39" value="Mañana_libre y Tarde_libre: horario por confirmar." style="text;html=1;align=left;verticalAlign=middle;fontSize=13;" vertex="1" parent="1"><mxGeometry x="1260" y="923" width="1760" height="24" as="geometry"/></mxCell><mxCell id="t40" value="C. La semana de cada persona: un solo inicio y un solo Fin" style="text;html=1;align=left;verticalAlign=middle;fontSize=18;fontStyle=1;" vertex="1" parent="1"><mxGeometry x="20" y="1013" width="1760" height="24" as="geometry"/></mxCell><mxCell id="t41" value="La misma red se copia para cada persona (Andrés, Klaudia, Oliver…). Si ya se sabe que un día es libre, ese día solo tiene su nodo Libre: no se crean nodos ni arcos de trabajo." style="text;html=1;align=left;verticalAlign=middle;fontSize=13;" vertex="1" parent="1"><mxGeometry x="20" y="1037" width="1760" height="24" as="geometry"/></mxCell><mxCell id="t42" value="D. Reglas fuera del dibujo" style="text;html=1;align=left;verticalAlign=middle;fontSize=16;fontStyle=1;" vertex="1" parent="1"><mxGeometry x="20" y="1158" width="1760" height="24" as="geometry"/></mxCell><mxCell id="t43" value="Cobertura, en cada bloque de 30 min: Σ personas en «Trabaja» + demanda no atendida ≥ demanda. La demanda no atendida se penaliza y sirve para planear contrataciones. Quien está en descanso no cuenta." style="text;html=1;align=left;verticalAlign=middle;fontSize=13;" vertex="1" parent="1"><mxGeometry x="20" y="1183" width="1760" height="24" as="geometry"/></mxCell><mxCell id="t44" value="Los costos son horas y cada día suma un total fijo: 8 h de trabajo + 1 h de almuerzo + 30 min de descanso = 9,5 h (libre: 4 + 4). Por eso la salida queda fija: entrada 07:00 → 16:30; 08:30 → 18:00." style="text;html=1;align=left;verticalAlign=middle;fontSize=13;" vertex="1" parent="1"><mxGeometry x="20" y="1208" width="1760" height="24" as="geometry"/></mxCell><mxCell id="t45" value="Por confirmar: horas exactas de las ventanas de descanso, costo de los arcos de descanso (¿0,25?), de almuerzo y entre días, y horario del medio día libre." style="text;html=1;align=left;verticalAlign=middle;fontSize=13;" vertex="1" parent="1"><mxGeometry x="20" y="1233" width="1760" height="24" as="geometry"/></mxCell></root></mxGraphModel></diagram></mxfile>